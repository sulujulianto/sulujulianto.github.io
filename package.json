{
  "name": "sulujulianto-portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio website with React, TypeScript, and Tailwind CSS for multi-language support.",
  "private": true,
  "scripts": {
    "audit:portfolio": "node scripts/audit-portfolio-data.mjs",
    "audit:baseline:update": "node scripts/audit-portfolio-data.mjs --update-baseline",
    "test:toolchain": "node --test tests/toolchain-config.test.mjs",
    "test:language": "npm run ts:build && node --test tests/language-resolver.test.mjs",
    "test:ui-locale": "node --test tests/ui-locale-id.test.mjs tests/ui-locale-contract.test.mjs tests/unified-pages.test.mjs",
    "test:history": "node --test tests/history-data.test.mjs",
    "test:skills": "node --test tests/skills-section.test.mjs",
    "test:projects": "node --test tests/project-details.test.mjs",
    "test:performance": "node --test tests/performance-regressions.test.mjs",
    "test:render-stability": "node tests/certificate-render-stability.browser.mjs",
    "test:css": "node --test tests/css-build.test.mjs",
    "test": "npm run test:toolchain && npm run test:language && npm run test:ui-locale && npm run test:history && npm run test:skills && npm run test:projects && npm run test:performance && npm run test:render-stability && npm run test:css",
    "verify": "npm run tailwind:build && npm run audit:portfolio && npm test",
    "tailwind:build": "tailwindcss -i ./assets/css/main.css -o ./assets/css/output.css",
    "tailwind:watch": "tailwindcss -i ./assets/css/main.css -o ./assets/css/output.css --watch",
    "ts:build": "tsc -p tsconfig.runtime.json",
    "blog:dev": "cd blog-fuwari && pnpm dev",
    "blog:build": "cd blog-fuwari && pnpm build",
    "blog:doctor": "cd blog-fuwari && pnpm doctor"
  },
  "keywords": [
    "portfolio",
    "react",
    "typescript",
    "tailwind-css",
    "multi-language",
    "personal-website"
  ],
  "author": "Sulu Edward Julianto",
  "license": "ISC",
  "engines": {
    "node": "^22.22.0 || ^24.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.4",
    "playwright": "1.62.1",
    "postcss": "^8.5.26",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.3"
  }
}
